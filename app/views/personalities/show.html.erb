<% if @result %>
  <div class="result-page <%= @theme %>">
    <div class="result-inner">
      <p class="result-eyebrow">あなたの性格タイプは...</p> 
      
      <div class="gem-icon"></div>
      <h1 class="gem-title"><%= @result[:name] %></h1>
      <p class="type-sub"><%= session[:axis_think] %> × <%= session[:axis_motive] %></p>

      <div class="result-cards">
        <div class="result-card">
          <h4>おすすめの業界</h4>
          <p><%= @result[:industry] %></p>
        </div>
        <div class="result-card">
          <h4>向いている職種</h4>
          <p><%= @result[:job] %></p>
        </div>
        <div class="result-card">
          <h4>求められる能力</h4>
          <p><%= @result[:skill] %></p>
        </div>
      </div>

      <div class="result-btns">
        <%= link_to "もう一度診断する", new_perfume_path, class: "btn-retry" %>
        <%= link_to "トップへ戻る", "/", class: "btn-retry" %>
      </div>
    </div>
  </div>

<% else %>
  <div class="result-page theme-sapphire">
    <div class="result-inner">
      <p class="result-lead">先に1つ目の診断を受けてください。</p>
      <div class="result-btns">
        <%= link_to "1つ目の診断へ", new_perfume_path, class: "btn-retry" %>
      </div>
    </div>
  </div>
<% end %>