<div class="intoro">
  <h5>診断結果</h5>
  <p>あなたの性格は...</p>
</div>
<div class="perfume-container">
  <% case [@perfume.question1, @perfume.question2, @perfume.question3, @perfume.question4, @perfume.question5] %>
  <% when ["1","1","1","1","1"], ["1","1","1","1","2"], ["1","1","2","1","1"], ["1","1","2","1","2"], ["1","2","1","1","1"], ["1","2","1","1","2"], ["2","1","1","1","1"], ["2","1","1","1","2"] %>
    <% type = "論理型 × 協力型" %>

  <% when ["1","1","1","2","1"], ["1","1","1","2","2"], ["1","1","2","2","1"], ["1","1","2","2","2"], ["1","2","1","2","1"], ["1","2","1","2","2"], ["2","1","1","2","1"], ["2","1","1","2","2"] %>
    <% type = "論理型 × 自走型" %>

  <% when ["1","2","2","1","1"], ["1","2","2","1","2"], ["2","1","2","1","1"], ["2","1","2","1","2"], ["2","2","1","1","1"], ["2","2","1","1","2"], ["2","2","2","1","1"], ["2","2","2","1","2"] %>
    <% type = "直感型 × 協力型" %>

  <% else %>
    <% type = "直感型 × 自走型" %>
  <% end %>

  <% result = {
    "論理型 × 協力型" => "道筋を立て、チームをまとめながら着実に進めるタイプ",
    "論理型 × 自走型" => "根拠をもとに、自分の判断で物事を組み立てる分析家タイプ",
    "直感型 × 協力型" => "ひらめきと場の空気を活かし、人を巻き込んで進めるタイプ",
    "直感型 × 自走型" => "感覚で本質をつかみ、自分の裁量で道を切り開くタイプ"
  } %>

  <h6><%= type %></h6>
  <p><%= result[type] %></p>

  <div class ="next" >
    <%= link_to "次に進む", new_personality_path, class: "link" %>
   </div>
</div>