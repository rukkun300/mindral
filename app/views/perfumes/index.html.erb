<section class="shindan">
  <div class="shindan-inner">
    <h1>Find Yourself<br>Shape Your<br>Future</h1>
    <div class="tag">自分自身を理解し 未来を形作ろう</div>
    <%= link_to "診断をはじめる →", new_perfume_path, class: "btn" %>
  </div>

  <!-- 右側の飾り(鉱石の結晶イメージ) -->
  <div class="hero-deco">
    <div class="deco deco1"></div>
    <div class="deco deco2"></div>
    <div class="deco deco3"></div>
    <div class="deco deco4"></div>
  </div>
</section>

<!-- 2画面目 -->
<section class="about">

  <!-- 背景の透かし文字 -->
  <div class="watermark">MINDRAL</div>

  <!-- 左端のラベル -->
  <div class="side-label">OUR<br>SYSTEM</div>

  <div class="about-inner">

    <!-- 中央見出し(単語ごとに色が変わる) -->
    <h2 class="about-title">
      <span class="c1">たった8問</span>で見つかる<br>
      あなたの<span class="c2">性格タイプ</span>と<span class="c3">適性業界</span>
    </h2>
    <p class="about-lead">
      Mindralは、あなたの<span>Mind</span>を分析し、自己理解を深めるためのサイトです<br>
      あなたの考え方のクセを見える化し、向いている業界・職種まで提案します。
    </p>
    <div class="about-btn-wrap">
      <%= link_to "診断をはじめる →", new_perfume_path, class: "btn-small" %>
    </div>

    <!-- Step 1/2/3 縦タイムライン -->
    <div class="timeline">

      <div class="tl-item">
        <div class="tl-circle">1</div>
        <div>
          <div class="tl-step">Step 1</div>
          <h3>8問の診断に答える</h3>
          <p>8個の2択形式の質問に回答してください</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-circle">2</div>
        <div>
          <div class="tl-step">Step 2</div>
          <h3>性格タイプ</h3>
          <p>回答結果から、8タイプのうちあなたのタイプを判定します。</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-circle">3</div>
        <div>
          <div class="tl-step">Step 3</div>
          <h3>適性業界・職種</h3>
          <p>性格タイプに合った業界・業種と<br>そこで求められる能力まで提案します。</p>
        </div>
      </div>

    </div>
  </div>
</section>