<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%#= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="header">
      <div class="header-logo">
        <a href="" class="logo"><span>Mind</span>ral</a> 
        <nav class="nav">
          <%= link_to "診断する", new_perfume_path %>
          <a href="#">業界・職種</a>
          <a href="#">性格タイプ</a>
        </nav>
      </div>
    </header>

    

<section class="shindan">
  <div class="shindan-inner">
    <h1>Find Yourself<br>Shape Your<br>Future</h1>
    <div class="tag">自分自身を理解し 未来を形作ろう</div>
    <%= link_to "診断をはじめる →", new_perfume_path, class: "btn" %>
  </div>

  <!-- 右側の飾り(鉱石の結晶イメージ) -->
  <div class="hero-deco">
    <div class="deco deco1"></div>
    <div class="deco deco2"></div>
    <div class="deco deco3"></div>
    <div class="deco deco4"></div>
  </div>
</section>

<!-- 2画面目 -->
   <section class="about">

  <!-- 背景の透かし文字 -->
  <div class="watermark">MINDRAL</div>

  <!-- 左端のラベル -->
  <div class="side-label">OUR<br>SERVICE</div>

  <div class="about-inner">

    <!-- 中央見出し(単語ごとに色が変わる) -->
    <h2 class="about-title">
      <span class="c1">たった8問</span>で見つかる、<br>
      あなたの<span class="c2">性格タイプ</span>と<span class="c3">適性業界</span>
    </h2>
    <p class="about-lead">
      Mindralは、自己理解を深めて就職活動を成功へ導く適性診断サイトです。<br>
      3つの軸からあなたの考え方のクセを見える化し、向いている業界・職種まで提案します。
    </p>
    <div class="about-btn-wrap">
      <%= link_to "診断をはじめる →", new_perfume_path, class: "btn-small" %>
    </div>

    <!-- Step 1/2/3 縦タイムライン -->
    <div class="timeline">

      <div class="tl-item">
        <div class="tl-circle">1</div>
        <div>
          <div class="tl-step">Step 1</div>
          <h3>8問の診断に答える</h3>
          <p>2択の質問に直感で回答。3分で完了します。</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-circle">2</div>
        <div>
          <div class="tl-step">Step 2</div>
          <h3>性格タイプがわかる</h3>
          <p>3つの軸から、8タイプのうちあなたのタイプを判定します。</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-circle">3</div>
        <div>
          <div class="tl-step">Step 3</div>
          <h3>適性業界・職種と出会う</h3>
          <p>タイプに合った業界と、そこで求められる能力まで提案します。</p>
        </div>
      </div>

    </div>
  </div>
</section>

    